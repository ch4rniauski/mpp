@page "/"
@inject HttpClient Http

<h3>Blazor клиент для WEB API</h3>

@if (_imageBytes != null)
{
    <img src="data:image/jpeg;base64,@Convert.ToBase64String(_imageBytes)" 
         alt="Из API" style="max-width: 500px;" />
}
else
{
    <p>Загрузка изображения...</p>
}

@code {
    private byte[]? _imageBytes;

    protected override async Task OnInitializedAsync()
    {
        await LoadImage();
    }

    private async Task LoadImage()
    {
        _imageBytes = null;
        
        try
        {
            _imageBytes = await Http.GetByteArrayAsync("/image.jpg");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }
}
